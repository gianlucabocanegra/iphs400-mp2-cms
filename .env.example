# Copy to .env (which is gitignored) and change the values.
# "local" lets the placeholder key below run (with a warning) so a fresh clone starts.
# Remove this line, and set a real key, for anything that is not your own computer.
CMS_ENV=local
# Required. Generate one: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Without CMS_ENV=local the console refuses to start while this is empty or the placeholder.
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE=Golf & Country Club of Trujillo
CMS_DATABASE=cms.db
# Demo accounts created by scripts/seed_demo.py
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
